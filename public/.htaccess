# Apache configuration. Point the domain's document root at this public/ folder.

Options -Indexes
DirectoryIndex index.php

# Never serve hidden files such as .htaccess or .user.ini.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect to HTTPS (uncomment once SSL is active). Only needed when the domain points
    # straight at public/; with the project in public_html use the root .htaccess instead.
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Admin panel front controller
    RewriteRule ^admin/?$ admin/index.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^admin/(.+)$ admin/index.php?route=$1 [L,QSA]

    RewriteRule ^shop$                  shop.php [L,QSA]
    RewriteRule ^shop/([a-z0-9-]+)$     shop.php?category=$1 [L,QSA]
    RewriteRule ^cakes/([a-z0-9-]+)$    product.php?slug=$1 [L,QSA]
    RewriteRule ^order/([A-Za-z0-9-]+)$ order.php?number=$1 [L,QSA]
    RewriteRule ^order/([A-Za-z0-9-]+)/invoice$ invoice.php?number=$1 [L,QSA]
    RewriteRule ^messages/([a-f0-9]{32})$ messages.php?token=$1 [L,QSA]
    RewriteRule ^quote/([a-f0-9]{32})$ quote.php?token=$1 [L,QSA]
    RewriteRule ^cart$                  cart.php [L,QSA]
    RewriteRule ^checkout$              checkout.php [L,QSA]
    RewriteRule ^custom-cakes$          custom-cakes.php [L,QSA]
    RewriteRule ^about$                 about.php [L,QSA]
    RewriteRule ^contact$               contact.php [L,QSA]
    RewriteRule ^login$                 login.php [L,QSA]
    RewriteRule ^register$              register.php [L,QSA]
    RewriteRule ^logout$                logout.php [L,QSA]
    RewriteRule ^account$               account.php [L,QSA]
    RewriteRule ^forgot-password$       forgot-password.php [L,QSA]
    RewriteRule ^reset-password$        reset-password.php [L,QSA]
    RewriteRule ^verify-email$          verify-email.php [L,QSA]
    RewriteRule ^faq$                   faq.php [L,QSA]
    RewriteRule ^(privacy-policy|terms|refund-policy|allergens)$ page.php?slug=$1 [L,QSA]
    RewriteRule ^api/slots$             api/slots.php [L,QSA]
    RewriteRule ^api/upload$            api/upload.php [L,QSA]
    RewriteRule ^api/coupon$            api/coupon.php [L,QSA]
    RewriteRule ^stripe-webhook$        stripe-webhook.php [L,QSA]
    RewriteRule ^sitemap\.xml$          sitemap.php [L]
    RewriteRule ^robots\.txt$           robots.php [L]

    # Pages written in Admin > Pages (policies and landing pages such as /birthday-cakes-canberra).
    # page.php shows the 404 page (and old website redirects) when no page has that address.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/?$ page.php?slug=$1 [L,QSA]

    # Anything else that is not a real file shows the 404 page.
    # (Relative rules keep this working both at the domain root and inside a sub-folder.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
