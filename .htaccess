# Lets the site run when the whole project sits in the web root, for example
# cPanel public_html (cloned or extracted there) or XAMPP htdocs/continentalcakeshop.
# Every request is passed to the public/ folder, so config/, src/, database/ and storage/
# can never be opened from a browser.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS and non-www on the live domain in a single 301 hop (leaves localhost untouched).
    RewriteCond %{HTTP_HOST} ^(?:www\.)?continentalcakeshop\.com\.au$ [NC]
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^(.*)$ https://continentalcakeshop.com.au/$1 [L,R=301]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Extra safety in case mod_rewrite is ever switched off: private folders and files are
# never served. Payment screenshots and custom cake photos live in storage/.
<IfModule mod_alias.c>
    RedirectMatch 404 /(storage|config|database|src|templates|cron|tests|\.git)(/|$)
</IfModule>
<FilesMatch "\.(sql|md|lock|log|env|example|key|ini)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
