# Lets the site run when the whole project sits in the web root, for example
# cPanel public_html (cloned or extracted there) or XAMPP htdocs/continentalcakeshop.
# Every request is passed to the public/ folder, so config/, src/, database/ and storage/
# can never be opened from a browser.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS on the live site. Remove the # from the next two lines once SSL is active.
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Extra safety in case mod_rewrite is ever switched off: private folders and files are
# never served. Payment screenshots and custom cake photos live in storage/.
<IfModule mod_alias.c>
    RedirectMatch 404 /(storage|config|database|src|templates|cron|\.git)(/|$)
</IfModule>
<FilesMatch "\.(sql|md|lock|log|env|example|key|ini)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
